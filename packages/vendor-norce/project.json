{
  "name": "vendor-norce",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/vendor-norce/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/vendor-norce",
        "main": "packages/vendor-norce/src/index.ts",
        "tsConfig": "packages/vendor-norce/tsconfig.lib.json",
        "assets": [
          {
            "input": "./packages/vendor-norce",
            "glob": "*.md",
            "output": "./"
          },
          {
            "input": "./packages/vendor-norce/src/templates",
            "glob": "**/*.xml",
            "output": "./src/templates"
          },
          {
            "input": "./packages/vendor-norce/src/templates",
            "glob": "**/*.json",
            "output": "./src/templates"
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
